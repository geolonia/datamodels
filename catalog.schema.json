{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://models.geonicdb.com/catalog.schema.json",
  "title": "GeonicDB data models catalog index",
  "description": "Wire format of catalog.json, read by GeonicDB, its console, CLI and MCP tool. Within a formatVersion fields are only added, never removed or retyped, so consumers must ignore unknown fields and this schema does not forbid them.",
  "type": "object",
  "required": [
    "formatVersion",
    "generatedAt",
    "models"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "typeIri",
          "subject",
          "domain",
          "source",
          "contextUrl",
          "contextAliasUrl",
          "schemaUrl",
          "version",
          "status",
          "title",
          "description",
          "sampleProperties",
          "pageUrl"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "typeIri": {
            "type": "string",
            "format": "uri"
          },
          "subject": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "domain": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "global",
              "profile",
              "minted"
            ]
          },
          "contextUrl": {
            "type": "string",
            "format": "uri"
          },
          "contextAliasUrl": {
            "type": "string",
            "format": "uri"
          },
          "schemaUrl": {
            "type": "string",
            "format": "uri"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "stable",
              "deprecated"
            ]
          },
          "title": {
            "$ref": "#/$defs/i18n"
          },
          "description": {
            "$ref": "#/$defs/i18n"
          },
          "sampleProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pageUrl": {
            "type": "string",
            "format": "uri"
          },
          "upstream": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              }
            }
          },
          "supersededBy": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": [
              "entity",
              "value"
            ],
            "description": "entity: an NGSI-LD entity type; value: a reusable value structure referenced from entity schemas. Absent means entity."
          },
          "aliasOf": {
            "type": "string",
            "format": "uri",
            "description": "Present when this type is another name for a type defined elsewhere in the catalog: same IRI, same attributes. typeIri equals aliasOf."
          },
          "subClassOf": {
            "type": "string",
            "format": "uri",
            "description": "Present when this type is a subclass of another catalog type: own IRI, attributes with the same name share the parent IRIs, parent required attributes stay required."
          },
          "adapters": {
            "type": "object",
            "description": "Files generated for a particular broker or tool, keyed by adapter name (for example geonicdb: a Custom Data Model request body). Absent when no adapter produces a file for the model.",
            "additionalProperties": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "required": [
        "ja",
        "en"
      ],
      "properties": {
        "ja": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    }
  }
}
