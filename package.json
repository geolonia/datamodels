{
  "name": "datamodels",
  "private": true,
  "version": "0.0.0",
  "description": "Bilingual catalog of NGSI-LD data models, served at datamodels.jp.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:immutability": "node scripts/check-immutability.mjs",
    "manifest:record": "npm run build && node scripts/check-immutability.mjs --record",
    "check": "npm run build:deploy && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build:deploy && wrangler deploy",
    "validate:models": "node scripts/validate-models.mjs",
    "test": "node --test \"test/**/*.test.mjs\" \"adapters/**/*.test.mjs\"",
    "export:geonicdb": "node adapters/geonicdb/export.mjs",
    "build:deploy": "npm run build && npm run check:immutability",
    "check:live": "node scripts/check-live.mjs",
    "site:dev": "node -e \"import('./scripts/lib/models.mjs').then(async m=>{const s=await m.loadSubjects();const g=await import('./scripts/lib/site.mjs');await g.generateSitePages(s)})\" && vitepress dev site"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonld": "^9.0.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.43",
    "wrangler": "4.132.0",
    "yaml": "^2.9.1"
  }
}
