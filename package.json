{
  "name": "geonicdb-models",
  "private": true,
  "version": "0.0.0",
  "description": "Curated bilingual catalog of NGSI-LD data models for GeonicDB, served at models.geonicdb.com.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.127.0"
  }
}
