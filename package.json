{
  "name": "datamodels",
  "private": true,
  "version": "0.0.0",
  "description": "Bilingual catalog of data models that work in Japan (JSON Schema, JSON-LD, NGSI-LD), served at datamodels.jp.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "new-model": "node scripts/new-model.mjs",
    "check": "npm run build:deploy && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build:deploy && wrangler deploy",
    "validate:models": "node scripts/validate-models.mjs",
    "nodes": "node scripts/fetch-nodes.mjs",
    "test": "node --test \"test/**/*.test.mjs\" \"adapters/**/*.test.mjs\"",
    "check:languages": "node scripts/check-languages.mjs",
    "lint:ja": "textlint site/index.md site/about.md site/ai.md \"site/guide/*.md\" \"site/toolkit/*.md\"",
    "export:geonicdb": "node adapters/geonicdb/export.mjs",
    "build:deploy": "npm run build && datamodels check . --offline --all-released",
    "check:live": "node scripts/check-live.mjs",
    "dist:diff": "node scripts/dist-diff.mjs",
    "site:dev": "node scripts/generate-pages.mjs && vitepress dev site"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@geolonia/datamodels": "0.3.18",
    "@modelcontextprotocol/server": "2.3.1",
    "@panzoom/panzoom": "4.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonld": "^9.0.0",
    "textlint": "15.8.0",
    "textlint-filter-rule-allowlist": "4.0.0",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-preset-jtf-style": "3.0.3",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.44",
    "wrangler": "4.151.0",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "undici@7.29.1": "7.30.1"
  }
}
