{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://models.geonicdb.com/schema/task/Comment/v1.1.0.json",
  "title": "Comment",
  "description": "A note, handover or reply on a task. Field change history is not a comment; the temporal API keeps history.",
  "x-version": "1.1.0",
  "x-license-url": "https://models.geonicdb.com/LICENSE-CONTENT",
  "x-model-tags": "GeonicDB, task management",
