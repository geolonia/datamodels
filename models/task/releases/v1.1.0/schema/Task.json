{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://models.geonicdb.com/schema/task/Task/v1.1.0.json",
  "title": "Task",
  "description": "A tracked unit of work: a ticket or issue in a tracker, a calendar to-do, a municipal work order. State and priority follow RFC 8984 (JSCalendar); the source system's own status name and kind are kept in statusLabel and subtype. Location may be any geometry.",
  "x-version": "1.1.0",
  "x-license-url": "https://models.geonicdb.com/LICENSE-CONTENT",
  "x-model-tags": "GeonicDB, task management",
  "x-derived-from": "https://www.rfc-editor.org/rfc/rfc8984.html",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Entity id (URN)"
    },
    "type": {
      "type": "string",
      "const": "Task",
      "description": "Entity type"
    },
    "name": {
      "type": "string",
      "description": "Name or subject",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/name"
    },
    "description": {
      "type": "string",
      "description": "Description",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#description"
    },
    "project": {
      "type": "string",
      "format": "uri",
      "description": "The project this belongs to, when the source system has projects",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://models.geonicdb.com/ns/task/Project"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/project"
    },
    "parent": {
      "type": "string",
      "format": "uri",
      "description": "Parent task (RFC 8984 relatedTo parent)",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://models.geonicdb.com/ns/task/Task"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/parent"
    },
    "relatedTo": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "description": "Related tasks. Always an array in the key-values form, even with one target. The kind of relation (blocks, precedes, duplicates) is left to extensions",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://models.geonicdb.com/ns/task/Task",
        "multi": true
      },
      "x-iri": "https://models.geonicdb.com/ns/task/relatedTo"
    },
    "refersTo": {
      "type": "string",
      "format": "uri",
      "description": "The entity this task is about (a report, an asset, a road)",
      "x-ngsi": {
        "type": "Relationship",
        "target": "any"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/refersTo"
    },
    "progress": {
      "type": "string",
      "enum": [
        "needs-action",
        "in-process",
        "completed",
        "failed",
        "cancelled"
      ],
      "description": "Normalised state (RFC 8984 progress: needs-action, in-process, completed, failed, cancelled)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/progress"
    },
    "statusLabel": {
      "type": "string",
      "description": "The source system's own status name, unchanged (for example \"In progress\", \"Resolved\")",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/statusLabel"
    },
    "subtype": {
      "type": "string",
      "description": "The source system's kind: tracker, issue type, category",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/subtype"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9,
      "description": "Priority 0 to 9: 1 highest, 9 lowest, 0 undefined (RFC 8984)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/priority"
    },
    "assignee": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "description": "Assignees: person, organisation or team entities, possibly outside this subject. Always an array in the key-values form, even with one target",
      "x-ngsi": {
        "type": "Relationship",
        "target": "agent",
        "multi": true
      },
      "x-iri": "https://models.geonicdb.com/ns/task/assignee"
    },
    "author": {
      "type": "string",
      "format": "uri",
      "description": "Creator (a person, organisation or team entity)",
      "x-ngsi": {
        "type": "Relationship",
        "target": "agent"
      },
      "x-iri": "https://schema.org/author"
    },
    "start": {
      "type": "string",
      "format": "date-time",
      "description": "Planned start (RFC 8984 start)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/start"
    },
    "due": {
      "type": "string",
      "format": "date-time",
      "description": "Due time (RFC 8984 due)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/due"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When progress became completed",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/completedAt"
    },
    "estimatedDuration": {
      "type": "string",
      "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
      "description": "Estimated effort as an ISO 8601 duration, e.g. PT1H30M (RFC 8984 estimatedDuration)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/estimatedDuration"
    },
    "percentComplete": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Completion 0 to 100 (RFC 8984 percentComplete)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/percentComplete"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords or labels",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://schema.org/keywords"
    },
    "location": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/simpleGeometry"
        },
        {
          "type": "object",
          "required": [
            "type",
            "geometries"
          ],
          "properties": {
            "type": {
              "const": "GeometryCollection"
            },
            "geometries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/simpleGeometry"
              }
            }
          }
        }
      ],
      "description": "Location as any GeoJSON geometry: point, line, polygon or a collection",
      "x-ngsi": {
        "type": "GeoProperty",
        "model": "https://purl.org/geojson/vocab#Geometry"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#location"
    },
    "spatialId": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Spatial IDs (ZFXY) covering the task. Optional",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/spatialId"
    },
    "isPrivate": {
      "type": "boolean",
      "description": "true when private; default false",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/isPrivate"
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "URL of this object in the system of record",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smart-data-models.github.io/data-models/terms.jsonld#/definitions/source"
    },
    "externalId": {
      "type": "string",
      "description": "Identifier in the system of record",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/externalId"
    },
    "dateCreated": {
      "type": "string",
      "format": "date-time",
      "description": "Creation time in the system of record (distinct from the broker attribute createdAt)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smart-data-models.github.io/data-models/terms.jsonld#/definitions/dateCreated"
    },
    "dateModified": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification time in the system of record",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smart-data-models.github.io/data-models/terms.jsonld#/definitions/dateModified"
    }
  },
  "required": [
    "id",
    "type",
    "name",
    "progress"
  ],
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "simpleGeometry": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Point"
            },
            "coordinates": {
              "$ref": "#/$defs/position"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "LineString"
            },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/position"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "$ref": "#/$defs/position"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiPoint"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/position"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiLineString"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/position"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiPolygon"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "$ref": "#/$defs/position"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
