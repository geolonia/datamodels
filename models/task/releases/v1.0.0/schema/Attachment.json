{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://models.geonicdb.com/schema/task/Attachment/v1.0.0.json",
  "title": "Attachment",
  "description": "Metadata of a file attached to a task or a project. The file itself stays outside the broker and is referenced by URL.",
  "x-version": "1.0.0",
  "x-license-url": "https://models.geonicdb.com/LICENSE-CONTENT",
  "x-model-tags": "GeonicDB, task management, GTT",
  "x-derived-from": "https://www.rfc-editor.org/rfc/rfc8984.html",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Entity id (URN)"
    },
    "type": {
      "type": "string",
      "const": "Attachment",
      "description": "Entity type"
    },
    "task": {
      "type": "string",
      "format": "uri",
      "description": "The task this belongs to",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://models.geonicdb.com/ns/task/Task"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/task"
    },
    "project": {
      "type": "string",
      "format": "uri",
      "description": "The project this belongs to",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://models.geonicdb.com/ns/task/Project"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/project"
    },
    "author": {
      "type": "string",
      "format": "uri",
      "description": "Creator (a person, organisation or team entity)",
      "x-ngsi": {
        "type": "Relationship",
        "target": "agent"
      },
      "x-iri": "https://schema.org/author"
    },
    "contentUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL of the file",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://schema.org/contentUrl"
    },
    "filename": {
      "type": "string",
      "description": "File name",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/filename"
    },
    "encodingFormat": {
      "type": "string",
      "description": "MIME type",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://schema.org/encodingFormat"
    },
    "contentSize": {
      "type": "integer",
      "minimum": 0,
      "description": "Size in bytes",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://schema.org/contentSize"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[A-Fa-f0-9]+$",
      "description": "Hash as algorithm:hex, e.g. sha256:…",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/digest"
    },
    "description": {
      "type": "string",
      "description": "Description",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#description"
    },
    "location": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      },
      "description": "Where the file was taken (a point)",
      "x-ngsi": {
        "type": "GeoProperty",
        "model": "https://purl.org/geojson/vocab#Point"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#location"
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "URL of this object in the system of record",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smart-data-models.github.io/data-models/terms.jsonld#/definitions/source"
    },
    "externalId": {
      "type": "string",
      "description": "Identifier in the system of record",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/externalId"
    },
    "dateCreated": {
      "type": "string",
      "format": "date-time",
      "description": "Creation time in the system of record (distinct from the broker attribute createdAt)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smart-data-models.github.io/data-models/terms.jsonld#/definitions/dateCreated"
    }
  },
  "required": [
    "id",
    "type",
    "contentUrl"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "task"
      ]
    },
    {
      "required": [
        "project"
      ]
    }
  ]
}
