{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodels.jp/schema/disaster/RoadClosure/v1.0.0.json",
  "title": "RoadClosure",
  "description": "One road closure or traffic regulation: road name, regulated section as a point, line or area, status and category.",
  "x-version": "1.0.0",
  "x-license-url": "https://datamodels.jp/LICENSE-CONTENT",
  "x-model-tags": "GeonicDB, disaster-response, Japan",
  "x-derived-from": "https://github.com/geolonia/geonicdb-datamodels",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Entity id (URN)"
    },
    "type": {
      "type": "string",
      "const": "RoadClosure",
      "description": "Entity type"
    },
    "project": {
      "type": "string",
      "format": "uri",
      "description": "The task subject's Project this entity belongs to, for example one disaster-response operation",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://datamodels.jp/ns/task/Project"
      },
      "x-iri": "https://datamodels.jp/ns/task/project"
    },
    "roadName": {
      "description": "Road name",
      "type": "string",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smartdatamodels.org/dataModel.Transportation/roadName"
    },
    "address": {
      "$ref": "https://datamodels.jp/schema/common/JapaneseAddress/v1.0.0.json",
      "description": "Address of the location, as a JapaneseAddress value (common subject)",
      "x-ngsi": {
        "type": "Property",
        "model": "https://datamodels.jp/ns/common/JapaneseAddress"
      },
      "x-iri": "https://schema.org/address"
    },
    "location": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/simpleGeometry"
        },
        {
          "type": "object",
          "required": [
            "type",
            "geometries"
          ],
          "properties": {
            "type": {
              "const": "GeometryCollection"
            },
            "geometries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/simpleGeometry"
              }
            }
          }
        }
      ],
      "description": "The regulated section, as a GeoJSON geometry. A point for a single-spot closure, a LineString for a section, a polygon for an area, matching the point/line/area regulation forms (点規制・線規制・面規制) of the NPA's traffic regulation data format (交通規制情報（拡張版標準フォーマット）説明書 Ver: k_2.1, JARTIC, 2025-01-20)",
      "x-ngsi": {
        "type": "GeoProperty",
        "model": "https://purl.org/geojson/vocab#Geometry"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#location"
    },
    "closureStatus": {
      "description": "Normalised closure state, the value space of Smart Data Models RoadSegment.status: closed (no traffic), limited (traffic possible but not in full capacity), open (closure lifted or not yet in place). The local wording goes in statusLabel; regulationCategory gives the finer public-sector category",
      "type": "string",
      "enum": [
        "closed",
        "limited",
        "open"
      ],
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/disaster/closureStatus"
    },
    "regulationCategory": {
      "description": "Regulation category, from the legend of MLIT's Road Information Provision System (道路情報提供システム 通行規制情報, road-info-prvs.mlit.go.jp, accessed 2026-09-24): the categories a road administrator uses for a driver-facing closure or restriction. Optional and independent of closureStatus",
      "type": "string",
      "enum": [
        "closedWeather",
        "closedConstruction",
        "closedHeavyVehicle",
        "closedWinter",
        "laneRestriction",
        "alternatingOneWay",
        "mobileRestriction",
        "chainRestriction",
        "chainGuidance",
        "other"
      ],
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/disaster/regulationCategory"
    },
    "statusLabel": {
      "type": "string",
      "description": "The closure status as the headquarters names it (依頼中, 通行止め中, 解除済み)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/task/statusLabel"
    },
    "validFrom": {
      "description": "When the closure takes effect",
      "type": "string",
      "format": "date-time",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smartdatamodels.org/validFrom"
    },
    "validTo": {
      "description": "When the closure is lifted",
      "type": "string",
      "format": "date-time",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smartdatamodels.org/dataModel.Alert/validTo"
    },
    "description": {
      "type": "string",
      "description": "Free-text memo",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#description"
    }
  },
  "required": [
    "id",
    "type",
    "project",
    "closureStatus",
    "location"
  ],
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "simpleGeometry": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Point"
            },
            "coordinates": {
              "$ref": "#/$defs/position"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "LineString"
            },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/position"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "$ref": "#/$defs/position"
                },
                "$comment": "RFC 7946 §3.1.6: a linear ring's first and last positions MUST be identical. JSON Schema has no keyword to compare two elements of a variable-length array, so this cannot be enforced here; scripts/validate-models.mjs checks it for this catalog's own examples."
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiPoint"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/position"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiLineString"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/position"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiPolygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "$ref": "#/$defs/position"
                  },
                  "$comment": "RFC 7946 §3.1.6: a linear ring's first and last positions MUST be identical. JSON Schema has no keyword to compare two elements of a variable-length array, so this cannot be enforced here; scripts/validate-models.mjs checks it for this catalog's own examples."
                }
              }
            }
          }
        }
      ]
    }
  }
}
