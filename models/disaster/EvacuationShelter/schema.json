{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://models.geonicdb.com/schema/disaster/EvacuationShelter/v3.0.0.json",
  "title": "EvacuationShelter",
  "description": "Operational overlay for one evacuation shelter. The shelter master data (name, location) is not included; it is referenced by externalShelterId. Only opening status and evacuee counts live here.",
  "x-version": "3.0.0",
  "x-license-url": "https://models.geonicdb.com/LICENSE-CONTENT",
  "x-model-tags": "GeonicDB, disaster-response, Japan",
  "x-derived-from": "https://github.com/geolonia/geonicdb-datamodels",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Entity id (URN)"
    },
    "type": {
      "type": "string",
      "const": "EvacuationShelter",
      "description": "Entity type"
    },
    "project": {
      "type": "string",
      "format": "uri",
      "description": "The disaster event (DisasterEvent) this entity belongs to",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://models.geonicdb.com/ns/task/Project"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/project",
      "x-geonicdb": {
        "indexed": true
      }
    },
    "externalShelterId": {
      "description": "The shelter's ID in the municipality's 指定緊急避難場所一覧 (推奨データセット; unique within the municipality, e.g. CC0100022200). Together with localGovernmentCode it identifies the shelter nationwide",
      "type": "string",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/externalShelterId",
      "x-geonicdb": {
        "indexed": true
      }
    },
    "localGovernmentCode": {
      "description": "Local government code of the municipality that publishes the shelter list (全国地方公共団体コード, 6 digits)",
      "type": "string",
      "pattern": "^\\d{6}$",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/common/localGovernmentCode"
    },
    "openingStatus": {
      "description": "Normalised opening state: open, closed, full (open but at capacity). The local wording goes in statusLabel",
      "type": "string",
      "enum": [
        "open",
        "closed",
        "full"
      ],
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/openingStatus"
    },
    "statusLabel": {
      "type": "string",
      "description": "The opening status as the headquarters names it (未開設, 開設中, 満員)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/statusLabel"
    },
    "evacueeHouseholds": {
      "description": "Number of evacuated households",
      "type": "integer",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/evacueeHouseholds",
      "minimum": 0
    },
    "evacueeTotal": {
      "description": "Total number of evacuees",
      "type": "integer",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/evacueeTotal",
      "minimum": 0
    },
    "evacueeFemale": {
      "description": "Number of female evacuees",
      "type": "integer",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/evacueeFemale",
      "minimum": 0
    },
    "evacueeMale": {
      "description": "Number of male evacuees",
      "type": "integer",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/evacueeMale",
      "minimum": 0
    },
    "description": {
      "type": "string",
      "description": "Free-text memo",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#description"
    },
    "openedAt": {
      "description": "Time the shelter opened",
      "type": "string",
      "format": "date-time",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/openedAt"
    },
    "closedAt": {
      "description": "Time the shelter closed",
      "type": "string",
      "format": "date-time",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/closedAt"
    }
  },
  "required": [
    "id",
    "type",
    "project",
    "externalShelterId",
    "localGovernmentCode",
    "openingStatus"
  ],
  "additionalProperties": false
}
