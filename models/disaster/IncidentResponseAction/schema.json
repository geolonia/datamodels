{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://models.geonicdb.com/schema/disaster/IncidentResponseAction/v3.0.0.json",
  "title": "IncidentResponseAction",
  "description": "One response action taken for an incident report: what, who, done or not. A subclass of Task in the task subject with the report as its parent.",
  "x-version": "3.0.0",
  "x-license-url": "https://models.geonicdb.com/LICENSE-CONTENT",
  "x-model-tags": "GeonicDB, disaster-response, Japan",
  "x-derived-from": "https://github.com/geolonia/geonicdb-datamodels",
  "x-subclass-of": "https://models.geonicdb.com/ns/task/Task",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Entity id (URN)"
    },
    "type": {
      "type": "string",
      "const": "IncidentResponseAction",
      "description": "Entity type"
    },
    "name": {
      "type": "string",
      "description": "What was done or is to be done (the former content)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/name"
    },
    "description": {
      "type": "string",
      "description": "Details of the action",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#description"
    },
    "project": {
      "type": "string",
      "format": "uri",
      "description": "The disaster event (DisasterEvent) this action belongs to; optional, the parent report carries it",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://models.geonicdb.com/ns/task/Project"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/project"
    },
    "parent": {
      "type": "string",
      "format": "uri",
      "description": "The incident report this action responds to",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://models.geonicdb.com/ns/disaster/IncidentReport"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/parent"
    },
    "progress": {
      "type": "string",
      "enum": [
        "needs-action",
        "in-process",
        "completed",
        "failed",
        "cancelled"
      ],
      "description": "Normalised state (RFC 8984 progress); the former isDone true is completed",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/progress"
    },
    "assignee": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "description": "Teams or persons responsible (entity URNs, always an array)",
      "x-ngsi": {
        "type": "Relationship",
        "target": "agent",
        "multi": true
      },
      "x-iri": "https://models.geonicdb.com/ns/task/assignee"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Completion time",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/completedAt"
    },
    "dateModified": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification in the source system, recorded by the application as a business update, separate from the broker system attribute modifiedAt",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smart-data-models.github.io/data-models/terms.jsonld#/definitions/dateModified"
    }
  },
  "required": [
    "id",
    "type",
    "name",
    "parent",
    "progress"
  ],
  "additionalProperties": false
}
