{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://models.geonicdb.com/schema/disaster/IncidentReport/v2.0.0.json",
  "title": "IncidentReport",
  "description": "One report from a resident or staff member: location, category, response status, who entered it, and the reporter (personal data). A subclass of Task in the task subject: name, progress, assignee-style attributes share the task IRIs.",
  "x-version": "2.0.0",
  "x-license-url": "https://models.geonicdb.com/LICENSE-CONTENT",
  "x-model-tags": "GeonicDB, disaster-response, Japan",
  "x-derived-from": "https://github.com/geolonia/geonicdb-datamodels",
  "x-subclass-of": "https://models.geonicdb.com/ns/task/Task",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Entity id (URN)"
    },
    "type": {
      "type": "string",
      "const": "IncidentReport",
      "description": "Entity type"
    },
    "name": {
      "type": "string",
      "description": "Short title of the report, for example category and place",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/name"
    },
    "description": {
      "type": "string",
      "description": "Free text: what was reported, current findings",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#description"
    },
    "project": {
      "type": "string",
      "format": "uri",
      "description": "The disaster event (DisasterEvent) this entity belongs to",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://models.geonicdb.com/ns/task/Project"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/project",
      "x-geonicdb": {
        "indexed": true
      }
    },
    "externalId": {
      "type": "string",
      "description": "Sequence number of the report within the disaster event, as a string",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/externalId"
    },
    "progress": {
      "type": "string",
      "enum": [
        "needs-action",
        "in-process",
        "completed",
        "failed",
        "cancelled"
      ],
      "description": "Normalised response state (RFC 8984 progress). The original labels map as 対応中 → in-process, 対応済み → in-process, 保留 → needs-action, 完了 → completed",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/progress"
    },
    "statusLabel": {
      "type": "string",
      "description": "The response status as the headquarters names it (対応中, 対応済み, 保留, 完了)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/statusLabel"
    },
    "subtype": {
      "type": "string",
      "description": "Category such as flooding, landslide, collapse, fallen tree, broken line. Not a closed list",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/subtype"
    },
    "author": {
      "type": "string",
      "format": "uri",
      "description": "The person or team who entered the report (an entity URN)",
      "x-ngsi": {
        "type": "Relationship",
        "target": "agent"
      },
      "x-iri": "https://schema.org/author"
    },
    "reportedAt": {
      "description": "Date and time the report was received",
      "type": "string",
      "format": "date-time",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://schema.org/dateReceived"
    },
    "pressReleaseStatus": {
      "description": "Press-release status",
      "type": "string",
      "enum": [
        "プレス済",
        "プレス予定",
        "対象外"
      ],
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/pressReleaseStatus"
    },
    "address": {
      "$ref": "https://models.geonicdb.com/schema/common/JapaneseAddress/v1.0.0.json",
      "description": "Address of the location, as a JapaneseAddress value (common subject)",
      "x-ngsi": {
        "type": "Property",
        "model": "https://models.geonicdb.com/ns/common/JapaneseAddress"
      },
      "x-iri": "https://schema.org/address"
    },
    "location": {
      "description": "Location of the incident",
      "type": "object",
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "x-ngsi": {
        "type": "GeoProperty",
        "model": "https://purl.org/geojson/vocab#Point"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#location"
    },
    "reporterName": {
      "description": "Reporter name (personal data)",
      "type": "string",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/reporterName",
      "x-geonicdb": {
        "pii": true
      }
    },
    "reporterPhone": {
      "description": "Reporter phone number (personal data)",
      "type": "string",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/reporterPhone",
      "x-geonicdb": {
        "pii": true
      }
    },
    "reporterAddress": {
      "description": "Reporter address (personal data)",
      "type": "string",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/reporterAddress",
      "x-geonicdb": {
        "pii": true
      }
    },
    "dateModified": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification in the source system, recorded by the application as a business update, separate from the broker system attribute modifiedAt",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smart-data-models.github.io/data-models/terms.jsonld#/definitions/dateModified"
    }
  },
  "required": [
    "id",
    "type",
    "name",
    "project",
    "externalId",
    "progress"
  ],
  "additionalProperties": false
}
