{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodels.jp/schema/disaster/EvacuationSite/v1.0.0.json",
  "title": "EvacuationSite",
  "description": "One designated emergency evacuation site (指定緊急避難場所, Basic Act on Disaster Management Art. 49-4): the master record a municipality publishes in its 指定緊急避難場所一覧, designated per hazard",
  "x-version": "1.0.0",
  "x-license-url": "https://datamodels.jp/LICENSE-CONTENT",
  "x-model-tags": "disaster-response, Japan",
  "x-derived-from": "https://www.digital.go.jp/resources/open_data/municipal-standard-data-set-test",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Entity id (URN)"
    },
    "type": {
      "type": "string",
      "const": "EvacuationSite",
      "description": "Entity type"
    },
    "name": {
      "type": "string",
      "description": "Name of the site or the building (名称)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/name"
    },
    "nameKana": {
      "type": "string",
      "description": "Name in full-width katakana (名称_カナ)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/disaster/nameKana"
    },
    "nameEn": {
      "type": "string",
      "description": "Name in English (名称_英字)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/disaster/nameEn"
    },
    "externalSiteId": {
      "type": "string",
      "description": "The site's ID in the municipality's 指定緊急避難場所一覧 (自治体標準オープンデータセット; unique within the municipality). Together with localGovernmentCode it identifies the site nationwide. Required unless nationalShelterId is given (GSI's data has no municipal ID)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/disaster/externalSiteId"
    },
    "nationalShelterId": {
      "type": "string",
      "pattern": "^E[0-9]{10}20[1-9A-Za-z]$",
      "description": "全国共通避難所・避難場所ID (GSI 共通ID): fixed 'E' + 5-digit municipality code + 5-digit facility code + type code '20' (designated emergency evacuation site) + 1 alphanumeric sequence starting at 1. Optional: omit it rather than send an empty string. Required unless externalSiteId is given",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/disaster/nationalShelterId"
    },
    "localGovernmentCode": {
      "type": "string",
      "pattern": "^\\d{6}$",
      "description": "Local government code of the municipality that designates the site and publishes the list (全国地方公共団体コード, 6 digits)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/common/localGovernmentCode"
    },
    "address": {
      "$ref": "https://datamodels.jp/schema/common/JapaneseAddress/v1.0.0.json",
      "description": "Address of the site, as a JapaneseAddress value (common subject). Its localGovernmentCode is the code of the municipality the site lies in, which can differ from the publisher's",
      "x-ngsi": {
        "type": "Property",
        "model": "https://datamodels.jp/ns/common/JapaneseAddress"
      },
      "x-iri": "https://schema.org/address"
    },
    "location": {
      "$ref": "https://datamodels.jp/schema/common/Geometry/v1.0.0.json",
      "properties": {
        "type": {
          "const": "Point"
        }
      },
      "description": "Where the site is, as a point",
      "x-ngsi": {
        "type": "GeoProperty",
        "model": "https://datamodels.jp/ns/common/Geometry"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#location"
    },
    "elevation": {
      "type": "number",
      "description": "Elevation of the site in metres above mean sea level (標高)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/disaster/elevation"
    },
    "hazardTypes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "flood",
          "landslide",
          "stormSurge",
          "earthquake",
          "tsunami",
          "greatFire",
          "inlandFlood",
          "eruption"
        ]
      },
      "description": "The hazards the site is designated for (災害種別; designation is per hazard): flood (洪水), landslide (崖崩れ、土石流及び地滑り), stormSurge (高潮), earthquake (地震), tsunami (津波), greatFire (大規模な火事), inlandFlood (内水氾濫), eruption (火山現象)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/disaster/hazardTypes"
    },
    "alsoDesignatedShelter": {
      "type": "boolean",
      "description": "true when the site is also a designated shelter (指定避難所との重複)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/disaster/alsoDesignatedShelter"
    },
    "maxCapacity": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of people the site is planned to hold (想定収容人数)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/disaster/maxCapacity"
    },
    "targetAreas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Neighbourhood associations or areas that evacuate to this site (対象となる町会・自治会)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://datamodels.jp/ns/disaster/targetAreas"
    },
    "telephone": {
      "type": "string",
      "description": "Contact telephone number",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://schema.org/telephone"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Web page of the site",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://schema.org/url"
    },
    "description": {
      "type": "string",
      "description": "Remarks (備考)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#description"
    }
  },
  "required": [
    "id",
    "type",
    "name",
    "localGovernmentCode"
  ],
  "anyOf": [
    {
      "required": [
        "externalSiteId"
      ]
    },
    {
      "required": [
        "nationalShelterId"
      ]
    }
  ],
  "additionalProperties": false
}
