{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "label": {
      "@id": "rdfs:label",
      "@container": "@language"
    },
    "comment": {
      "@id": "rdfs:comment",
      "@container": "@language"
    },
    "subClassOf": {
      "@id": "rdfs:subClassOf",
      "@type": "@id"
    },
    "isDefinedBy": {
      "@id": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "seeAlso": {
      "@id": "rdfs:seeAlso",
