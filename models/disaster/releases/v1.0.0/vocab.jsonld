        "en": "true when the site is also a designated welfare shelter"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/EvacuationSite/#alsoWelfareShelter"
