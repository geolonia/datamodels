    },
    {
      "@id": "https://datamodels.jp/ns/disaster/externalShelterId",
      "@type": "rdf:Property",
      "label": {
        "en": "externalShelterId"
      },
      "comment": {
        "ja": "市町村の避難所一覧における ID（市町村内で一意）。nationalShelterId が無いときは必須",
        "en": "The shelter's ID in the municipality's own list (unique within it). Required when nationalShelterId is not given"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/DesignatedShelter/#externalShelterId"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/externalSiteId",
      "@type": "rdf:Property",
      "label": {
        "en": "externalSiteId"
      },
      "comment": {
        "ja": "自治体の指定緊急避難場所一覧における ID（自治体内で一意）。localGovernmentCode と合わせて全国で一意になる。nationalShelterId が無いときは必須（国土地理院のデータには自治体の ID が無い）",
        "en": "The site's ID in the municipality's list (unique within the municipality). Together with localGovernmentCode it is unique nationwide. Required when nationalShelterId is not given (GSI's data has no municipal ID)"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/EvacuationSite/#externalSiteId"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/hazardTypes",
      "@type": "rdf:Property",
      "label": {
        "en": "hazardTypes"
      },
      "comment": {
        "ja": "指定されている災害の種別。flood（洪水）、landslide（崖崩れ、土石流及び地滑り）、stormSurge（高潮）、earthquake（地震）、tsunami（津波）、greatFire（大規模な火事）、inlandFlood（内水氾濫）、eruption（火山現象）",
        "en": "The hazards the site is designated for: flood, landslide (landslides, debris flows and slope failures), stormSurge, earthquake, tsunami, greatFire (large-scale fire), inlandFlood (inland flooding), eruption (volcanic phenomena)"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/EvacuationSite/#hazardTypes"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/maxCapacity",
      "@type": "rdf:Property",
      "label": {
        "en": "maxCapacity"
      },
      "comment": {
        "ja": "想定収容人数",
        "en": "Number of people the shelter is planned to hold"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/DesignatedShelter/#maxCapacity"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/nameEn",
      "@type": "rdf:Property",
      "label": {
        "en": "nameEn"
      },
      "comment": {
        "ja": "名称の英語表記",
        "en": "Name in English"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/EvacuationSite/#nameEn"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/nameKana",
      "@type": "rdf:Property",
      "label": {
        "en": "nameKana"
      },
      "comment": {
        "ja": "施設名の読み（全角カタカナ）",
        "en": "Name in full-width katakana"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/DesignatedShelter/#nameKana"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/nationalShelterId",
      "@type": "rdf:Property",
      "label": {
        "en": "nationalShelterId"
      },
      "comment": {
        "ja": "全国共通避難所・避難場所ID（国土地理院のデータの「共通ID」）。14桁：固定値 E ＋ 自治体コード5桁 ＋ 施設コード5桁 ＋ 種別コード（1 = 指定避難所。続く 1 = 一般、2 = 福祉）＋ 連番1桁。externalShelterId が無いときは必須",
        "en": "The nationwide common ID (the '共通ID' of GSI's data). 14 characters: fixed 'E' + 5-digit municipality code + 5-digit facility code + type code (1 = designated shelter; then 1 = general, 2 = welfare) + 1 sequence character. Required when externalShelterId is not given"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/DesignatedShelter/#nationalShelterId"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/openedAt",
      "@type": "rdf:Property",
      "label": {
        "en": "openedAt"
      },
      "comment": {
        "ja": "開設日時",
        "en": "Time the shelter opened"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/EvacuationShelter/#openedAt"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/openingStatus",
      "@type": "rdf:Property",
      "label": {
        "en": "openingStatus"
      },
      "comment": {
        "ja": "正規化した開設状況: open（開設中）、closed（未開設・閉鎖）、full（満員）、requested（開設を依頼・指示されたが開設未確認。公的な統制語彙は見つからなかった区分）。現場の呼び方は必ず statusLabel にも記載する。値域に合う値がないときは省き、statusLabel だけを送る",
        "en": "Normalised opening state: open, closed, full (open but at capacity), requested (opening has been requested/instructed but not yet confirmed open; no public controlled vocabulary defines this state). The local wording always also goes in statusLabel. When no value fits, leave it out and send only statusLabel"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/EvacuationShelter/#openingStatus"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/shelter",
      "@type": "rdf:Property",
      "label": {
        "en": "shelter"
      },
      "comment": {
        "ja": "この運用状況が対象とする指定避難所（DesignatedShelter）",
        "en": "The designated shelter (DesignatedShelter) this operation record is for"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/EvacuationShelter/#shelter"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/shelterType",
      "@type": "rdf:Property",
      "label": {
        "en": "shelterType"
      },
      "comment": {
        "ja": "general（一般避難所）または welfare（福祉避難所、特別な配慮が必要な人のため）。nationalShelterId の種別コードの2桁目と同じ",
        "en": "general (一般避難所) or welfare (福祉避難所, for people who need special care); the same as the second type digit of nationalShelterId"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/DesignatedShelter/#shelterType"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/site",
      "@type": "rdf:Property",
      "label": {
        "en": "site"
      },
      "comment": {
        "ja": "同じ場所の指定緊急避難場所（EvacuationSite）",
        "en": "The designated emergency evacuation site (EvacuationSite) at the same place"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/DesignatedShelter/#site"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/targetAreas",
      "@type": "rdf:Property",
      "label": {
        "en": "targetAreas"
      },
      "comment": {
        "ja": "この避難場所に避難する町会・自治会や地域",
        "en": "Neighbourhood associations or areas that evacuate to this site"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/EvacuationSite/#targetAreas"
    },
    {
      "@id": "https://datamodels.jp/ns/disaster/targetEvacuees",
      "@type": "rdf:Property",
      "label": {
        "en": "targetEvacuees"
      },
      "comment": {
        "ja": "受入対象者（市町村の書き方のまま。福祉避難所の対象など）",
        "en": "Who the shelter is for, in the municipality's words (for example for a welfare shelter)"
      },
      "isDefinedBy": "https://datamodels.jp/ns/disaster/",
      "seeAlso": "https://datamodels.jp/models/disaster/DesignatedShelter/#targetEvacuees"
    }
  ]
}
