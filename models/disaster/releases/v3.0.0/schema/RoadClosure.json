{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://models.geonicdb.com/schema/disaster/RoadClosure/v3.0.0.json",
  "title": "RoadClosure",
  "description": "One road closure: road name, closed section as a LineString, and status.",
  "x-version": "3.0.0",
  "x-license-url": "https://models.geonicdb.com/LICENSE-CONTENT",
  "x-model-tags": "GeonicDB, disaster-response, Japan",
  "x-derived-from": "https://github.com/geolonia/geonicdb-datamodels",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Entity id (URN)"
    },
    "type": {
      "type": "string",
      "const": "RoadClosure",
      "description": "Entity type"
    },
    "project": {
      "type": "string",
      "format": "uri",
      "description": "The disaster event (DisasterEvent) this entity belongs to",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://models.geonicdb.com/ns/task/Project"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/project",
      "x-geonicdb": {
        "indexed": true
      }
    },
    "roadName": {
      "description": "Road name",
      "type": "string",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smartdatamodels.org/dataModel.Transportation/roadName"
    },
    "address": {
      "$ref": "https://models.geonicdb.com/schema/common/JapaneseAddress/v1.0.0.json",
      "description": "Address of the location, as a JapaneseAddress value (common subject)",
      "x-ngsi": {
        "type": "Property",
        "model": "https://models.geonicdb.com/ns/common/JapaneseAddress"
      },
      "x-iri": "https://schema.org/address"
    },
    "location": {
      "description": "The closed section, as a LineString",
      "type": "object",
      "properties": {
        "type": {
          "const": "LineString"
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "x-ngsi": {
        "type": "GeoProperty",
        "model": "https://purl.org/geojson/vocab#LineString"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#location"
    },
    "closureStatus": {
      "description": "Normalised closure state, the value space of Smart Data Models RoadSegment.status: closed (no traffic), limited (traffic possible but not in full capacity), open (closure lifted or not yet in place). The local wording goes in statusLabel",
      "type": "string",
      "enum": [
        "closed",
        "limited",
        "open"
      ],
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/disaster/closureStatus"
    },
    "statusLabel": {
      "type": "string",
      "description": "The closure status as the headquarters names it (依頼中, 通行止め中, 解除済み)",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://models.geonicdb.com/ns/task/statusLabel"
    },
    "validFrom": {
      "description": "When the closure takes effect",
      "type": "string",
      "format": "date-time",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smartdatamodels.org/validFrom"
    },
    "validTo": {
      "description": "When the closure is lifted",
      "type": "string",
      "format": "date-time",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smartdatamodels.org/dataModel.Alert/validTo"
    },
    "description": {
      "type": "string",
      "description": "Free-text memo",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.8.jsonld#description"
    }
  },
  "required": [
    "id",
    "type",
    "project",
    "closureStatus"
  ],
  "additionalProperties": false
}
