{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodels.jp/schema/disaster/IncidentHandoverNote/v1.0.0.json",
  "title": "IncidentHandoverNote",
  "description": "One handover note about an incident report, from one team to another. A subclass of Comment in the task subject.",
  "x-version": "1.0.0",
  "x-license-url": "https://datamodels.jp/LICENSE-CONTENT",
  "x-model-tags": "GeonicDB, disaster-response, Japan",
  "x-derived-from": "https://github.com/geolonia/geonicdb-datamodels",
  "x-subclass-of": "https://datamodels.jp/ns/task/Comment",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Entity id (URN)"
    },
    "type": {
      "type": "string",
      "const": "IncidentHandoverNote",
      "description": "Entity type"
    },
    "task": {
      "type": "string",
      "format": "uri",
      "description": "The incident report this entity refers to",
      "x-ngsi": {
        "type": "Relationship",
        "target": "https://datamodels.jp/ns/disaster/IncidentReport"
      },
      "x-iri": "https://datamodels.jp/ns/task/task"
    },
    "author": {
      "type": "string",
      "format": "uri",
      "description": "The sending team or person (an entity URN)",
      "x-ngsi": {
        "type": "Relationship",
        "target": "agent"
      },
      "x-iri": "https://schema.org/author"
    },
    "recipient": {
      "description": "The receiving team or person (an entity URN)",
      "type": "string",
      "format": "uri",
      "x-ngsi": {
        "type": "Relationship",
        "target": "agent"
      },
      "x-iri": "https://schema.org/recipient"
    },
    "text": {
      "type": "string",
      "description": "The note",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://schema.org/text"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "description": "Time the note was sent",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://schema.org/dateSent"
    },
    "dateModified": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification in the source system, recorded by the application as a business update, separate from the broker system attribute modifiedAt",
      "x-ngsi": {
        "type": "Property"
      },
      "x-iri": "https://smart-data-models.github.io/data-models/terms.jsonld#/definitions/dateModified"
    }
  },
  "required": [
    "id",
    "type",
    "task",
    "text"
  ],
  "additionalProperties": false
}
