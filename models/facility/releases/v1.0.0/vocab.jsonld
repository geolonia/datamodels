      },
      "isDefinedBy": "https://datamodels.jp/ns/facility/",
      "seeAlso": "https://datamodels.jp/models/facility/AEDLocation/#remarks"
    },
    {
      "@id": "https://datamodels.jp/ns/facility/restrictedAccess",
      "@type": "rdf:Property",
      "label": {
        "en": "restrictedAccess"
      },
      "comment": {
        "ja": "立ち入りが制限された区域にあり、一般の人が使えなければ true（データセットの「外部利用不可」）",
