      "isDefinedBy": "https://datamodels.jp/ns/facility/",
      "seeAlso": "https://datamodels.jp/models/facility/PublicToilet/#maleWesternStyleToilets"
    },
    {
      "@id": "https://datamodels.jp/ns/facility/medicalDepartments",
      "@type": "rdf:Property",
      "label": {
        "en": "medicalDepartments"
      },
      "comment": {
        "ja": "診療科目。公開者が書いたとおりの名前です（例：内科、整形外科）。",
        "en": "Clinical departments, as written by the publisher, for example 内科 or 整形外科"
      },
      "isDefinedBy": "https://datamodels.jp/ns/facility/",
      "seeAlso": "https://datamodels.jp/models/facility/MedicalInstitution/#medicalDepartments"
    },
    {
      "@id": "https://datamodels.jp/ns/facility/medicalInstitutionCode",
      "@type": "rdf:Property",
      "label": {
        "en": "medicalInstitutionCode"
      },
      "comment": {
        "ja": "医療機関コード。データセットのとおりに書きます（定義書の記入例は 10 桁）。",
        "en": "Medical institution code, as the dataset gives it (the example in the definition sheet has 10 digits)"
      },
      "isDefinedBy": "https://datamodels.jp/ns/facility/",
      "seeAlso": "https://datamodels.jp/models/facility/MedicalInstitution/#medicalInstitutionCode"
    },
    {
      "@id": "https://datamodels.jp/ns/facility/medicalInstitutionType",
      "@type": "rdf:Property",
      "label": {
        "en": "medicalInstitutionType"
      },
      "comment": {
        "ja": "医療機関の種類。hospital（病院、20 床以上）、clinicWithBeds（有床診療所、1〜19 床）、clinicWithoutBeds（無床診療所）、clinic（診療所。一覧が病床の有無を書いていないもの）、dentalClinic（歯科診療所）",
        "en": "Kind of medical institution: hospital (20 beds or more), clinicWithBeds (1 to 19 beds), clinicWithoutBeds (no beds), clinic (a clinic whose list does not say whether it has beds), dentalClinic (a dental clinic)"
      },
      "isDefinedBy": "https://datamodels.jp/ns/facility/",
      "seeAlso": "https://datamodels.jp/models/facility/MedicalInstitution/#medicalInstitutionType"
    },
    {
      "@id": "https://datamodels.jp/ns/facility/numberOfBeds",
      "@type": "rdf:Property",
      "label": {
        "en": "numberOfBeds"
      },
      "comment": {
        "ja": "病床数",
        "en": "Number of beds"
      },
      "isDefinedBy": "https://datamodels.jp/ns/facility/",
      "seeAlso": "https://datamodels.jp/models/facility/MedicalInstitution/#numberOfBeds"
    },
    {
      "@id": "https://datamodels.jp/ns/facility/operatorName",
      "@type": "rdf:Property",
      "label": {
        "en": "operatorName"
      },
      "comment": {
        "ja": "AED を設置した組織の名称（データセットの「団体名」）",
        "en": "Name of the organisation that installed the AED (団体名 in the dataset)"
      },
      "isDefinedBy": "https://datamodels.jp/ns/facility/",
      "seeAlso": "https://datamodels.jp/models/facility/AEDLocation/#operatorName"
    },
