      "isDefinedBy": "https://datamodels.jp/ns/facility/",
      "seeAlso": "https://datamodels.jp/models/facility/PublicToilet/#femaleWesternStyleToilets"
    },
    {
      "@id": "https://datamodels.jp/ns/facility/installationLocation",
      "@type": "rdf:Property",
      "label": {
        "en": "installationLocation"
