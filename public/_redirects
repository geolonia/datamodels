# Redirects for datamodels.jp (Workers static assets).
#
# Type and attribute IRIs under /ns/<subject>/ resolve to the page that
# documents them, schema.org style. The entries are generated at build time
# from models/ and appended below this header.

# /guide/procurement (sample procurement wording) was published and removed on 2026-09-29: no reader had asked for it.
/guide/procurement /guide/ 301
/en/guide/procurement /en/guide/ 301

# Guides regrouped on 2026-10-09: "Versions and deprecation" merged into "URLs and versions", "Tips & Tricks" became "Your own names".
/guide/versioning /guide/urls 301
/en/guide/versioning /en/guide/urls 301
/guide/tips /guide/names 301
/en/guide/tips /en/guide/names 301

# "Standards mapped" moved to the guides as "Find a model by standard" on 2026-10-09.
