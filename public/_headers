# Response headers for models.geonicdb.com (Workers static assets).
# Rules are glob patterns; all matching rules apply.
#
# Contexts and schemas are fetched cross-origin by brokers, JSON-LD processors
# and browsers, so CORS is open for everything. Nothing here is private.
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# JSON-LD contexts. Exact versions (vX.Y.Z) get long immutable caching once
# they exist; aliases (vX) get a short max-age. Those rules are added together
# with the first published version so the pattern is tested against real files.
/context/*
  Content-Type: application/ld+json; charset=utf-8

# JSON Schemas.
/schema/*
  Content-Type: application/schema+json; charset=utf-8

# The machine-readable catalog index read by GeonicDB.
/catalog.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300
