# Response headers for datamodels.jp (Workers static assets).
#
# Matching rules (Cloudflare): one `*` splat per rule at most; a request
# inherits the headers of every matching rule; the same header set by several
# rules is joined with commas unless a later rule detaches it first with
# `! Header-Name`. The immutable Cache-Control for exact versions is therefore
# generated per file at build time (scripts/lib/publish.mjs) and appended
# below, each with `! Cache-Control` before the new value.
# Verify live after a change: `npm run check:live`.
#
# Contexts and schemas are fetched cross-origin by brokers, JSON-LD processors
# and browsers, so CORS is open for everything. Nothing here is private.
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# JSON-LD contexts. Aliases (vN.jsonld) advance to the latest compatible
# version, so they get a short cache; exact versions get the generated
# immutable rule. A 404 under this path is also labelled ld+json, since the
# request asked for a .jsonld file.
/context/*.jsonld
  Content-Type: application/ld+json; charset=utf-8
  Cache-Control: public, max-age=300

# Vocabularies (RDFS classes, subclass relations, labels), same versioning rules.
/vocab/*.jsonld
  Content-Type: application/ld+json; charset=utf-8
  Cache-Control: public, max-age=300

# JSON Schemas, same versioning rules.
/schema/*.json
  Content-Type: application/schema+json; charset=utf-8
  Cache-Control: public, max-age=300

# Examples and adapter files (for example GeonicDB Custom Data Model bodies).
/examples/*.jsonld
  Content-Type: application/ld+json; charset=utf-8
/examples/*.json
  Content-Type: application/json; charset=utf-8
/adapters/*.json
  Content-Type: application/json; charset=utf-8

# The machine-readable catalog index.
/catalog.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300
/catalog.schema.json
  Content-Type: application/schema+json; charset=utf-8
/LICENSE-CONTENT
  Content-Type: text/plain; charset=utf-8
